<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SIGM-HELI | Gestión de Flota Cloud</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- React & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    
    <!-- Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- Recharts -->
    <script src="https://unpkg.com/prop-types@15.8.1/prop-types.min.js"></script>
    <script src="https://unpkg.com/recharts@2.1.12/umd/Recharts.js"></script>

    <!-- SheetJS (Excel) -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, sendPasswordResetEmail } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Exponemos las funciones al entorno global para que React (Babel) las consuma sincrónicamente
        window.FirebaseCloud = {
            initializeApp, getAuth, signInAnonymously, signInWithCustomToken, sendPasswordResetEmail,
            getFirestore, doc, setDoc, onSnapshot, collection
        };
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; -webkit-tap-highlight-color: transparent; }
        .animate-fade-in { animation: fadeIn 0.3s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom); }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo, useRef } = React;
        
        // Fallback seguro para Recharts
        const SafeRecharts = window.Recharts || {
            BarChart: () => null, Bar: () => null, XAxis: () => null, YAxis: () => null, Tooltip: () => null, 
            ResponsiveContainer: ({children}) => <div className="h-full w-full flex items-center justify-center bg-gray-50 text-gray-400 font-bold text-sm border rounded">Cargando gráfico...</div>, 
            CartesianGrid: () => null, Legend: () => null, PieChart: ({children}) => <div className="flex items-center justify-center h-full">{children}</div>, Pie: () => null, Cell: () => null
        };
        const { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid, Legend, PieChart, Pie, Cell } = SafeRecharts;

        // Roles del Sistema
        const ROLES = { 
            GERENTE: 'Gerente (de la empresa)', 
            ADMIN: 'Administrador (de la empresa)', 
            MECANICO: 'Mecánico (de la empresa)', 
            OPERADOR_CLIENTE: 'Operador de Cliente' 
        };

        const Modal = ({ isOpen, onClose, title, children, size = "max-w-md" }) => {
            if (!isOpen) return null;
            return (
                <div className="fixed inset-0 bg-black/60 z-50 flex justify-center items-center p-4 backdrop-blur-sm animate-fade-in">
                    <div className={`bg-white rounded-2xl shadow-2xl w-full ${size} flex flex-col max-h-[90vh]`}>
                        <div className="flex justify-between items-center p-5 border-b">
                            <h3 className="text-xl font-bold text-gray-800">{title}</h3>
                            <button onClick={onClose} className="text-gray-400 hover:text-red-500 transition text-2xl leading-none">&times;</button>
                        </div>
                        <div className="p-5 overflow-y-auto">
                            {children}
                        </div>
                    </div>
                </div>
            );
        };

        const StatusBadge = ({ isActive }) => (
            <span className={`px-2 py-1 rounded-full text-xs font-bold ${isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                {isActive ? 'Activo' : 'Inactivo'}
            </span>
        );

        const getAssetSemaforo = (asset) => {
            if(!asset) return { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fa-question', label: 'Desconocido' };
            const diff = (Number(asset.currentHorometer) || 0) - (Number(asset.lastServiceHorometer) || 0);
            const isCombustion = ['Diésel', 'Gas', 'Gasolina'].includes(asset.type);
            const limit = isCombustion ? 250 : 500;
            const disp2 = limit - 36; 
            const disp1 = limit - 50; 
            
            if (diff >= limit) return { bg: 'bg-red-100', text: 'text-red-800', border: 'border-red-200', icon: 'fa-times-circle', label: 'Mantenimiento Vencido', nextHrs: 0 };
            if (diff >= disp2) return { bg: 'bg-yellow-100', text: 'text-yellow-800', border: 'border-yellow-200', icon: 'fa-exclamation-triangle', label: 'Alerta Ejecución (Faltan <36h)', nextHrs: limit - diff };
            if (diff >= disp1) return { bg: 'bg-orange-100', text: 'text-orange-800', border: 'border-orange-200', icon: 'fa-clipboard-list', label: 'Alerta Planeación (Faltan <50h)', nextHrs: limit - diff };
            return { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-200', icon: 'fa-check-circle', label: 'Operativo', nextHrs: limit - diff };
        };

        const DashboardModule = ({ assets, workOrders }) => {
            const activeAssets = assets.filter(a => a.isActive);
            const fleetStatus = activeAssets.reduce((acc, asset) => {
                const s = getAssetSemaforo(asset).label;
                acc[s] = (acc[s] || 0) + 1;
                return acc;
            }, {});

            const COLORS = { 
                'Operativo': '#10b981', 
                'Alerta Planeación (Faltan <50h)': '#f97316', 
                'Alerta Ejecución (Faltan <36h)': '#eab308', 
                'Mantenimiento Vencido': '#ef4444' 
            };
            const pieData = Object.keys(fleetStatus).map(k => ({ name: k, value: fleetStatus[k] }));

            return (
                <div className="space-y-6 animate-fade-in pb-20 md:pb-6">
                    <h2 className="text-2xl font-black text-gray-800"><i className="fas fa-chart-pie text-red-600 mr-2"></i>Dashboard Gerencial</h2>
                    
                    <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
                            <div><p className="text-gray-500 text-sm font-bold">Flota Activa</p><p className="text-3xl font-black text-gray-800">{activeAssets.length}</p></div>
                            <div className="bg-blue-100 p-3 rounded-lg"><i className="fas fa-truck-loading text-blue-600 text-xl"></i></div>
                        </div>
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
                            <div><p className="text-gray-500 text-sm font-bold">OTs Abiertas</p><p className="text-3xl font-black text-gray-800">{workOrders.filter(o=>o.status==='Abierta').length}</p></div>
                            <div className="bg-yellow-100 p-3 rounded-lg"><i className="fas fa-tools text-yellow-600 text-xl"></i></div>
                        </div>
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
                            <div><p className="text-gray-500 text-sm font-bold">Equipos Operativos</p><p className="text-3xl font-black text-green-600">{fleetStatus['Operativo'] || 0}</p></div>
                            <div className="bg-green-100 p-3 rounded-lg"><i className="fas fa-check-circle text-green-600 text-xl"></i></div>
                        </div>
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100 flex items-center justify-between">
                            <div><p className="text-gray-500 text-sm font-bold">Equipos Vencidos</p><p className="text-3xl font-black text-red-600">{fleetStatus['Mantenimiento Vencido'] || 0}</p></div>
                            <div className="bg-red-100 p-3 rounded-lg"><i className="fas fa-times-circle text-red-600 text-xl"></i></div>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
                            <h3 className="font-bold text-gray-700 mb-4">Estado de Flota (Semáforo)</h3>
                            <div className="h-64">
                                {pieData.length > 0 ? (
                                    <ResponsiveContainer width="100%" height="100%">
                                        <PieChart>
                                            <Pie data={pieData} innerRadius={60} outerRadius={80} paddingAngle={5} dataKey="value">
                                                {pieData.map((entry, index) => <Cell key={`cell-${index}`} fill={COLORS[entry.name]} />)}
                                            </Pie>
                                            <Tooltip />
                                            <Legend />
                                        </PieChart>
                                    </ResponsiveContainer>
                                ) : (
                                    <div className="flex items-center justify-center h-full text-gray-400 font-bold text-sm">Sin datos de equipos activos</div>
                                )}
                            </div>
                        </div>
                        
                        <div className="bg-white p-5 rounded-xl shadow-sm border border-gray-100">
                            <h3 className="font-bold text-gray-700 mb-4">Atención Prioritaria (Top 5 Semáforo)</h3>
                            <div className="space-y-3">
                                {activeAssets.length > 0 ? activeAssets.map(a => ({...a, sem: getAssetSemaforo(a)}))
                                    .sort((a,b) => a.sem.nextHrs - b.sem.nextHrs)
                                    .slice(0, 5)
                                    .map(asset => (
                                    <div key={asset.id} className={`p-3 rounded-lg border ${asset.sem.bg} ${asset.sem.border} flex justify-between items-center`}>
                                        <div>
                                            <p className="font-bold text-sm text-gray-900">{asset.model} - {asset.vin}</p>
                                            <p className="text-xs text-gray-600">{asset.location}</p>
                                        </div>
                                        <div className="text-right">
                                            <span className={`text-xs font-bold px-2 py-1 rounded-md bg-white/50 ${asset.sem.text}`}>
                                                <i className={`fas ${asset.sem.icon} mr-1`}></i>
                                                {asset.sem.label}
                                            </span>
                                            <p className="text-xs font-mono mt-1 font-bold">{asset.sem.nextHrs} Hrs restantes</p>
                                        </div>
                                    </div>
                                )) : <div className="text-gray-400 font-bold text-sm text-center py-4">Sin equipos registrados</div>}
                            </div>
                        </div>
                    </div>
                </div>
            );
        };

        const OperatorInputModule = ({ currentUser, assets, onUpdateHorometer }) => {
            const [selectedAsset, setSelectedAsset] = useState(null);
            const [isUpdateModalOpen, setIsUpdateModalOpen] = useState(false);
            const [newHorometer, setNewHorometer] = useState('');
            const [opError, setOpError] = useState('');

            const [reportIssue, setReportIssue] = useState(false);
            const [reqData, setReqData] = useState({ 
                turno: 'Diurno',
                combustibleInicial: 'Lleno', combustibleFinal: 'Lleno', cambioGas: false,
                fugas: 'OK', llantas: 'OK', luces: 'OK', frenos: 'OK', mastil: 'OK',
                observaciones: '', 
                requester: currentUser?.name || '', contact: '', type: 'Mantenimiento Correctivo (Reparación)', priority: 'Normal', description: ''
            });

            const [assetSearchTerm, setAssetSearchTerm] = useState('');
            const [showAssetDropdown, setShowAssetDropdown] = useState(false);

            const activeAssets = assets.filter(a => a.isActive);

            const handleOperatorSubmit = (e) => {
                e.preventDefault();
                setOpError('');
                if (!selectedAsset) {
                    setOpError('Debe utilizar el buscador para identificar su equipo.');
                    return;
                }
                const currentHrs = selectedAsset.currentHorometer || 0;
                if (Number(newHorometer) < currentHrs) {
                    setOpError(`Error: El horómetro no puede ser menor al registrado previamente (${currentHrs}).`);
                    return;
                }
                
                const reportPayload = reportIssue ? { ...reqData } : null;
                onUpdateHorometer(selectedAsset, Number(newHorometer), reportPayload, reqData);
                
                setIsUpdateModalOpen(false);
                setNewHorometer('');
                setReportIssue(false);
                setAssetSearchTerm('');
                setSelectedAsset(null);
            };

            const filteredAssets = activeAssets.filter(a => 
                a.model.toLowerCase().includes(assetSearchTerm.toLowerCase()) || 
                a.vin.toLowerCase().includes(assetSearchTerm.toLowerCase()) ||
                a.id.toLowerCase().includes(assetSearchTerm.toLowerCase())
            );

            return (
                <div className="pb-24 animate-fade-in">
                    <div className="bg-red-600 -mx-4 -mt-4 p-6 pb-12 rounded-b-3xl text-white shadow-md">
                        <h2 className="text-2xl font-black">Registro Operativo</h2>
                        <p className="text-red-100 text-sm opacity-90 mt-1">Identifique su equipo para registrar jornada</p>
                    </div>
                    <div className="bg-white p-4 rounded-xl shadow-lg -mt-6 mx-2 relative z-20">
                         <div className="relative">
                            <label className="block text-xs font-bold text-gray-700 mb-1">Búsqueda Manual de Montacargas *</label>
                            <div className="flex bg-gray-50 border-2 border-gray-200 rounded-lg p-1 focus-within:border-red-500 transition">
                                <div className="flex items-center justify-center pl-3 pr-2 text-gray-400"><i className="fas fa-search"></i></div>
                                <input 
                                    type="text" 
                                    className="w-full p-2 text-sm bg-transparent outline-none font-bold text-gray-800 placeholder-gray-400"
                                    placeholder="Teclear N° Económico, Modelo o VIN..."
                                    value={assetSearchTerm}
                                    onChange={e => { setAssetSearchTerm(e.target.value); setShowAssetDropdown(true); }}
                                    onFocus={() => setShowAssetDropdown(true)}
                                    onBlur={() => setTimeout(() => setShowAssetDropdown(false), 200)}
                                />
                            </div>
                            {showAssetDropdown && (
                                <div className="absolute z-30 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-2xl max-h-48 overflow-y-auto">
                                    {filteredAssets.length > 0 ? filteredAssets.map(a => (
                                        <div key={a.id} className="p-3 hover:bg-red-50 cursor-pointer border-b last:border-0" onMouseDown={() => {
                                            setSelectedAsset(a);
                                            setAssetSearchTerm(`${a.id.substring(0,6).toUpperCase()} - ${a.model}`);
                                            setShowAssetDropdown(false);
                                            setNewHorometer(''); 
                                            setOpError(''); 
                                            setIsUpdateModalOpen(true);
                                        }}>
                                            <div className="flex justify-between items-center">
                                                <span className="font-black text-gray-800">{a.model} <span className="text-xs font-mono bg-red-100 text-red-700 px-2 py-0.5 rounded ml-1">Eco: {a.id.substring(0,6).toUpperCase()}</span></span>
                                                <span className="text-xs bg-gray-100 px-2 py-1 rounded font-bold">{a.currentHorometer || 0} Hrs</span>
                                            </div>
                                            <span className="text-xs text-gray-500 font-mono block mt-1">VIN: {a.vin} | {a.location}</span>
                                        </div>
                                    )) : <div className="p-3 text-sm font-bold text-gray-500 text-center"><i className="fas fa-exclamation-circle text-red-400 text-2xl block mb-1"></i>No se encontró el equipo</div>}
                                </div>
                            )}
                        </div>
                    </div>

                    <Modal isOpen={isUpdateModalOpen} onClose={() => setIsUpdateModalOpen(false)} title="Reporte de Horómetro Diario" size="max-w-2xl">
                        <form onSubmit={handleOperatorSubmit} className="space-y-6">
                            {opError && <div className="bg-red-100 text-red-700 p-3 rounded-lg text-sm font-bold">{opError}</div>}
                            
                            <div className="grid grid-cols-2 gap-3 bg-gray-50 p-3 border rounded-xl">
                                <div><span className="text-[10px] uppercase font-bold text-gray-500 block">Fecha y Turno</span><span className="font-bold text-sm text-gray-800">{new Date().toLocaleDateString()} - <select className="bg-transparent border-b border-blue-200 outline-none font-bold text-blue-600 ml-1" value={reqData.turno} onChange={e=>setReqData({...reqData, turno: e.target.value})}><option>Diurno</option><option>Nocturno</option><option>1er Turno</option><option>2do Turno</option><option>3er Turno</option></select></span></div>
                                <div><span className="